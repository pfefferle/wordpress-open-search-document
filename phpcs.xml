<?xml version="1.0"?>
<ruleset name="Open Search Document">
	<description>Coding standards for the Open Search Document plugin.</description>

	<file>.</file>
	<exclude-pattern>.(git|github|vscode|idea|wordpress-org|data)</exclude-pattern>
	<exclude-pattern>*\.(inc|css|js|svg)</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="50"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="text_domain" value="open-search-document,default"/>

	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress">
		<exclude name="Universal.Operators.DisallowShortTernary" />
	</rule>
	<rule ref="VariableAnalysis"/>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
